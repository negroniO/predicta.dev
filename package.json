{
  "name": "george-portfolio-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "esbuild": "^0.27.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "local:admin": "node scripts/open-local-admin.mjs",
    "local:stop": "docker compose -f compose.local.yml -p predicta-local down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "prisma:seed": "node prisma/seed.cjs",
    "test:integration": "node tests/run-integration.mjs",
    "test:browser": "node tests/run-integration.mjs --browser",
    "test:services": "docker compose -f compose.test.yml -p predicta-tests up -d --wait",
    "test:services:stop": "docker compose -f compose.test.yml -p predicta-tests down",
    "audit:dependencies": "npm audit --audit-level=high --fetch-timeout=20000 --fetch-retries=0"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.84.0",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^12.23.24",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.554.0",
    "marked": "^17.0.1",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "dotenv-cli": "^7.4.4",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
