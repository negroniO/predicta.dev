# Local development only. Never put real secrets in this template.
DATABASE_URL="postgresql://postgres:local_password@127.0.0.1:5432/predicta_dev"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GITHUB_ID="replace-with-github-oauth-client-id"
GITHUB_SECRET="replace-with-github-oauth-client-secret"
# Stable numeric GitHub ID for negroniO. An empty override denies all admins.
ADMIN_GITHUB_IDS="203515807"

# Optional until cover uploads are needed; keep the service role key server-side.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Required for production rate limiting (Redis failure returns 503 for public writes).
REDIS_URL=""
# Empty selects Redis in production and bounded process memory in development.
# Explicit memory mode is for development or deliberate single-process deployments.
RATE_LIMIT_BACKEND=""
# Set only to a header your trusted proxy overwrites with the client IP.
# Empty uses one shared rate-limit bucket per endpoint scope.
RATE_LIMIT_IP_HEADER=""
# Shared origin for canonicals, structured data, sharing, sitemap and feeds.
# Set this to https://predicta.dev in production, before building.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_BASE_URL is supported only as a fallback for older deployments.
